{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Co-Speech Gesture Atlas records",
  "description": "Record definitions for data/papers/*.yaml, data/datasets.yaml and data/metrics.yaml. Enforced by scripts/validate.py.",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.\\d{4,9}/\\S+$"
    },
    "language": {
      "description": "ISO 639-1 code",
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "setting": {
      "enum": ["monologue", "dyadic", "multi-party"]
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "year", "venue", "type", "category", "added", "checked", "verified"],
      "properties": {
        "id": {
          "description": "First author's family name, year, one keyword from the title or method name",
          "type": "string",
          "pattern": "^[a-z]+\\d{4}[a-z0-9]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "venue": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["journal", "conference", "workshop", "poster", "preprint", "thesis", "book"]
        },
        "category": {
          "enum": ["method", "dataset", "survey", "challenge", "evaluation", "system", "theory"]
        },
        "area": {
          "description": "For theory records: the discipline the study belongs to",
          "enum": ["psycholinguistics", "linguistics", "cognition", "development", "neuroscience", "social-interaction", "clinical", "education", "perception", "other"]
        },
        "doi": { "$ref": "#/$defs/doi" },
        "arxiv": {
          "description": "arXiv identifier without version, quoted so YAML keeps it a string",
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{4,5}$"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paper": { "$ref": "#/$defs/url" },
            "open": { "$ref": "#/$defs/url" },
            "code": { "$ref": "#/$defs/url" },
            "project": { "$ref": "#/$defs/url" },
            "video": { "$ref": "#/$defs/url" }
          }
        },
        "weights": {
          "description": "Whether trained weights are released",
          "type": "boolean"
        },
        "input": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["text", "audio", "speaker-id", "style", "emotion", "seed-motion", "image", "video", "interlocutor"]
          }
        },
        "output": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["upper-body", "full-body", "hands", "face", "locomotion"]
          }
        },
        "representation": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["keypoints-2d", "joints-3d", "smpl-x", "video-pixels", "other"]
          }
        },
        "approach": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "rule-based", "retrieval", "regression", "vae", "gan", "normalizing-flow",
              "vq", "autoregressive", "masked-modeling", "diffusion", "flow-matching",
              "llm", "hybrid", "other"
            ]
          }
        },
        "setting": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "$ref": "#/$defs/setting" }
        },
        "realtime": {
          "enum": ["real-time", "offline", "unreported"]
        },
        "latency": { "type": "string" },
        "datasets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/language" }
        },
        "metrics": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" }
        },
        "user_study": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "notes": { "type": "string" },
        "added": { "$ref": "#/$defs/date" },
        "checked": {
          "description": "What the record's fields were read from",
          "enum": ["full-text", "abstract", "metadata"]
        },
        "verified": { "type": "boolean" }
      },
      "allOf": [
        {
          "description": "Only a record read from the full text can be verified",
          "if": {
            "required": ["verified"],
            "properties": { "verified": { "const": true } }
          },
          "then": { "properties": { "checked": { "const": "full-text" } } }
        },
        {
          "description": "Every record must be publicly identifiable",
          "anyOf": [
            { "required": ["doi"] },
            { "required": ["arxiv"] },
            {
              "required": ["links"],
              "properties": { "links": { "required": ["paper"] } }
            }
          ]
        },
        {
          "description": "weights only makes sense alongside a code link",
          "if": { "required": ["weights"] },
          "then": {
            "required": ["links"],
            "properties": { "links": { "required": ["code"] } }
          }
        },
        {
          "description": "latency only makes sense when realtime is stated",
          "if": { "required": ["latency"] },
          "then": { "required": ["realtime"] }
        },
        {
          "description": "A verified record carries authors and a summary",
          "if": {
            "required": ["verified"],
            "properties": { "verified": { "const": true } }
          },
          "then": { "required": ["authors", "summary"] }
        },
        {
          "description": "A verified method record fills the whole comparison row",
          "if": {
            "required": ["verified", "category"],
            "properties": {
              "verified": { "const": true },
              "category": { "const": "method" }
            }
          },
          "then": {
            "required": [
              "input", "output", "approach", "setting",
              "realtime", "datasets", "metrics", "user_study"
            ]
          }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "added", "verified"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "paper": {
          "description": "id of the record in data/papers that introduced the dataset",
          "type": "string"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page": { "$ref": "#/$defs/url" },
            "download": { "$ref": "#/$defs/url" },
            "paper": { "$ref": "#/$defs/url" }
          }
        },
        "modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["audio", "text", "video", "body-motion", "hand-motion", "face-motion", "annotations"]
          }
        },
        "capture": {
          "enum": ["mocap", "pose-estimation", "synthetic", "mixed"]
        },
        "representation": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["keypoints-2d", "joints-3d", "smpl-x", "video-pixels", "other"]
          }
        },
        "hours": { "type": "number", "exclusiveMinimum": 0 },
        "speakers": { "type": "integer", "minimum": 1 },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/language" }
        },
        "setting": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": { "$ref": "#/$defs/setting" }
        },
        "access": { "enum": ["open", "on-request", "unavailable"] },
        "license": { "type": "string" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "notes": { "type": "string" },
        "added": { "$ref": "#/$defs/date" },
        "verified": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["verified"],
            "properties": { "verified": { "const": true } }
          },
          "then": {
            "required": ["year", "links", "modalities", "capture", "languages", "setting", "access", "summary"]
          }
        }
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "added", "verified"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "aka": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "measures": {
          "enum": ["realism", "synchrony", "diversity", "semantics", "accuracy", "smoothness", "other"]
        },
        "better": { "enum": ["higher", "lower", "closer-to-reference"] },
        "paper": {
          "description": "id of the record in data/papers that introduced the metric, if it is in scope",
          "type": "string"
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paper": { "$ref": "#/$defs/url" },
            "code": { "$ref": "#/$defs/url" }
          }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "caveats": { "type": "string" },
        "added": { "$ref": "#/$defs/date" },
        "verified": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["verified"],
            "properties": { "verified": { "const": true } }
          },
          "then": { "required": ["measures", "better", "summary"] }
        }
      ]
    }
  }
}
